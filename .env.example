# Application Configuration
PROJECT_NAME="Namma Ooru AI"
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Development default uses local aiosqlite, Production uses PostGIS)
# Development:
DATABASE_URL="sqlite+aiosqlite:///./namma_ooru.db"
# Production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql+asyncpg://namma_user:namma_secure_password@localhost:5432/namma_ooru_db"

# Object Storage / Uploads
UPLOAD_DIR="./uploads"

# External Integrations (Optional)
FCM_SERVER_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
